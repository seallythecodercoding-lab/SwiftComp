<Window x:Class="SwiftComp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SwiftComp → output/" Height="620" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8FAFC" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#2563EB" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SwiftComp" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Arraste a pasta → 1 clique → output/" FontSize="12" Foreground="#DBEAFE" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#1E40AF" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock x:Name="TipoBadge" Text="—" Foreground="White" FontSize="11" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Drop Zone -->
        <Border Grid.Row="1" Margin="20,16,20,12" Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="2" Padding="20"
                x:Name="DropCard" AllowDrop="True" Drop="Card_Drop" DragOver="Card_DragOver" DragLeave="Card_DragLeave">
            <Grid>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#EFF6FF" CornerRadius="40" Width="72" Height="72" HorizontalAlignment="Center">
                        <TextBlock Text="📁" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Arraste a pasta do projeto aqui" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4" Foreground="#1E293B"/>
                    <TextBlock Text="ou clique para selecionar" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <Button Content="Selecionar pasta" Click="Pick_Click" Margin="0,16,0,0" Padding="24,9" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Center">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                    <TextBlock Text="Dica: arraste a pasta direto sobre o .exe no Explorer" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>
                </StackPanel>

                <StackPanel x:Name="SelectedState" Visibility="Collapsed" VerticalAlignment="Center">
                    <Border Background="#DCFCE7" CornerRadius="20" Width="40" Height="40" HorizontalAlignment="Center">
                        <TextBlock Text="✓" FontSize="20" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="Projeto selecionado" FontSize="12" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <Border Background="#F1F5F9" CornerRadius="10" Padding="12,10" Margin="0,14,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="📂" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PathText" Grid.Column="1" Text="C:\..." FontSize="11" FontFamily="Consolas" Margin="8,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="#334155"/>
                            <Button Grid.Column="2" Content="Trocar" Click="Pick_Click" FontSize="11" Padding="10,5" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                    <Border Background="#EFF6FF" CornerRadius="10" Padding="12,10" Margin="0,10,0,0" BorderBrush="#BFDBFE" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="SAÍDA" FontSize="9" FontWeight="Bold" Foreground="#2563EB"/>
                            <TextBlock x:Name="OutText" Text="...\output" FontSize="11" FontFamily="Consolas" Foreground="#1E40AF" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            <TextBlock x:Name="CmdText" Text="dotnet build -o output" FontSize="10" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom -->
        <StackPanel Grid.Row="2" Margin="20,0,20,16">
            <Button x:Name="CompileBtn" Click="Compile_Click" IsEnabled="False" Height="52" FontSize="14" FontWeight="Bold" Background="#16A34A" Foreground="White" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                <Button.Content>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="▶" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="COMPILAR → output/" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#16A34A"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#15803D"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Grid Margin="0,10,0,0" Height="14">
                <ProgressBar x:Name="Prog" Height="6" Visibility="Collapsed" IsIndeterminate="True" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="Pronto. Arraste uma pasta." FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <Border Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,8,0,0" Height="86" BorderBrush="#1E293B" BorderThickness="1">
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="LogText" Text="Logs aparecerão aqui..." FontFamily="Consolas" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="14"/>
                </ScrollViewer>
            </Border>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="📂 Abrir output" Click="OpenOut_Click" FontSize="11" Padding="0,8" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand" HorizontalAlignment="Stretch">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>
                <Button Grid.Column="2" Content="📁 Abrir projeto" Click="OpenSrc_Click" FontSize="11" Padding="0,8" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand" HorizontalAlignment="Stretch">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
